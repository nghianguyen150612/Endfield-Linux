{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endfield-unix.invalid/schema/game-launch-plan-v1.schema.json",
  "title": "Endfield-Unix game launch plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_required",
    "blockers",
    "executable",
    "executable_relative",
    "expected_process_behavior",
    "game_registry_revision",
    "installation_id",
    "plan_id",
    "policy",
    "prefix",
    "prefix_id",
    "process_execution_supported",
    "process_ownership",
    "profile",
    "runtime",
    "schema_version",
    "side_effects",
    "state",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "prefix_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "profile": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 96
    },
    "executable_relative": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "game_registry_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "prefix": {
      "$ref": "#/$defs/prefix"
    },
    "executable": {
      "$ref": "#/$defs/executable"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "prepared",
        "blocked",
        "requires_approval",
        "approved",
        "starting",
        "started",
        "exited",
        "failed",
        "cancelled"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "process_execution_supported": {
      "type": "boolean",
      "const": false
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      },
      "maxItems": 16
    },
    "expected_process_behavior": {
      "const": "no_process_created"
    },
    "process_ownership": {
      "const": "none"
    }
  },
  "$defs": {
    "evidenceState": {
      "enum": [
        "verified",
        "unknown",
        "missing",
        "stale",
        "unsupported"
      ]
    },
    "adapter": {
      "enum": [
        "managed_wine",
        "external_wine",
        "umu_proton",
        "direct_proton"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "selection_source",
        "runtime_id",
        "family",
        "adapter",
        "pin_id",
        "pin_revision",
        "managed_ownership_verified",
        "baseline_integrity_verified",
        "external_structure_revalidated",
        "external_trust_policy_documented",
        "invocation_contract_verified"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/evidenceState"
        },
        "selection_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "family": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "pin_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        },
        "pin_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "managed_ownership_verified": {
          "type": "boolean"
        },
        "baseline_integrity_verified": {
          "type": "boolean"
        },
        "external_structure_revalidated": {
          "type": "boolean"
        },
        "external_trust_policy_documented": {
          "type": "boolean"
        },
        "invocation_contract_verified": {
          "type": "boolean"
        }
      }
    },
    "prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "prefix_id",
        "lifecycle",
        "managed_ownership_verified",
        "directory_identity_verified",
        "runtime_association_matches",
        "registry_revision",
        "initialization_verified",
        "recovery_pending"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/evidenceState"
        },
        "prefix_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        },
        "lifecycle": {
          "enum": [
            "planned",
            "created",
            "initialized",
            "incomplete",
            "recovery_required",
            "missing",
            "blocked"
          ]
        },
        "managed_ownership_verified": {
          "type": "boolean"
        },
        "directory_identity_verified": {
          "type": "boolean"
        },
        "runtime_association_matches": {
          "type": "boolean"
        },
        "registry_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "initialization_verified": {
          "type": "boolean"
        },
        "recovery_pending": {
          "type": "boolean"
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "exists",
        "regular_file",
        "symlink_free",
        "within_registered_root",
        "root_identity_matches",
        "file_device",
        "file_inode",
        "file_size",
        "format",
        "publisher_authenticity_verified"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "exists": {
          "type": "boolean"
        },
        "regular_file": {
          "type": "boolean"
        },
        "symlink_free": {
          "type": "boolean"
        },
        "within_registered_root": {
          "type": "boolean"
        },
        "root_identity_matches": {
          "type": "boolean"
        },
        "file_device": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "file_inode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "file_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "format": {
          "enum": [
            "pe_coff",
            "other",
            "unknown"
          ]
        },
        "publisher_authenticity_verified": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "process_creation_allowed",
        "approval_required"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/evidenceState"
        },
        "process_creation_allowed": {
          "type": "boolean"
        },
        "approval_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "blocker": {
      "enum": [
        "game_not_registered",
        "game_root_changed",
        "executable_missing",
        "executable_not_regular",
        "executable_symlink",
        "executable_outside_root",
        "executable_identity_unknown",
        "executable_format_unsupported",
        "runtime_pin_missing",
        "runtime_stale",
        "runtime_unknown",
        "runtime_integrity_unverified",
        "external_trust_policy_missing",
        "adapter_mismatch",
        "adapter_unsupported",
        "prefix_missing",
        "prefix_uninitialized",
        "prefix_stale",
        "prefix_recovery_pending",
        "prefix_initialization_unsupported",
        "critical_dependency_finding",
        "critical_dependency_readiness_unknown",
        "compatibility_unsupported",
        "execution_policy_unknown"
      ]
    },
    "warning": {
      "enum": [
        "publisher_authenticity_unknown",
        "compatibility_unknown",
        "anti_cheat_compatibility_unknown",
        "runtime_network_effects_unknown",
        "process_supervision_not_persistent"
      ]
    }
  }
}
