{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://endfield-unix.invalid/schema/wine-runtime-qualification-v1",
  "title": "P034 read-only Wine runtime qualification v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "wine10-linux-x86_64-conservative-v1"
    },
    "runtime_installation_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "pin_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "pin_revision": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_sha256": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "ownership": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "unsupported",
        "not_run",
        "unknown",
        "blocked"
      ]
    },
    "integrity": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "unsupported",
        "not_run",
        "unknown",
        "blocked"
      ]
    },
    "executable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "executable_identity": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object": {
            "type": "string",
            "maxLength": 128
          },
          "state": {
            "enum": [
              "verified_managed",
              "trusted_system",
              "missing",
              "untrusted",
              "unverifiable",
              "dynamic_not_established",
              "unsupported"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "elf": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "class": {
                "const": 64
              },
              "machine": {
                "const": 62
              },
              "executable_type": {
                "enum": [
                  2,
                  3
                ]
              },
              "interpreter": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "needed": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "rpath": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "runpath": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "dynamic_loading_not_established": {
                "const": true
              }
            },
            "required": [
              "class",
              "machine",
              "executable_type",
              "interpreter",
              "needed",
              "rpath",
              "runpath",
              "dynamic_loading_not_established"
            ]
          }
        },
        "required": [
          "object",
          "state",
          "sha256",
          "elf"
        ]
      }
    },
    "helper_inventory": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "unsupported",
        "not_run",
        "unknown",
        "blocked"
      ]
    },
    "helpers": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string"
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "integrity": {
            "type": "string",
            "enum": [
              "verified",
              "missing",
              "unsupported",
              "not_run",
              "unknown",
              "blocked"
            ]
          }
        },
        "required": [
          "role",
          "candidate_count",
          "integrity"
        ]
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {
          "const": "wine-mirror/wine:wine-10.0"
        },
        "source_semantics": {
          "type": "string",
          "enum": [
            "verified",
            "missing",
            "unsupported",
            "not_run",
            "unknown",
            "blocked"
          ]
        },
        "artifact_mapping": {
          "type": "string",
          "enum": [
            "verified",
            "missing",
            "unsupported",
            "not_run",
            "unknown",
            "blocked"
          ]
        },
        "arguments": {
          "const": [
            "wineboot.exe",
            "--init"
          ]
        },
        "environment": {
          "const": [
            "WINEPREFIX"
          ]
        },
        "working_directory": {
          "const": "exact-selected-managed-prefix"
        },
        "direct_exit_is_completion": {
          "const": false
        }
      },
      "required": [
        "source_ref",
        "source_semantics",
        "artifact_mapping",
        "arguments",
        "environment",
        "working_directory",
        "direct_exit_is_completion"
      ]
    },
    "invocation_contract": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "unsupported",
        "not_run",
        "unknown",
        "blocked"
      ]
    },
    "completion_verifier": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "unsupported",
        "not_run",
        "unknown",
        "blocked"
      ]
    },
    "descendant_completion": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "unsupported",
        "not_run",
        "unknown",
        "blocked"
      ]
    },
    "authentic_qualification": {
      "const": "not_run"
    },
    "host_compatible": {
      "type": "boolean"
    },
    "production_initialization": {
      "const": "blocked"
    },
    "approval_required": {
      "const": true
    },
    "blockers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "host_architecture": {
      "type": "string",
      "maxLength": 32
    },
    "host_os": {
      "type": "string",
      "maxLength": 32
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "runtime_installation_id",
    "pin_id",
    "pin_revision",
    "artifact_sha256",
    "ownership",
    "integrity",
    "executable_sha256",
    "executable_identity",
    "dependencies",
    "helper_inventory",
    "helpers",
    "invocation",
    "invocation_contract",
    "completion_verifier",
    "descendant_completion",
    "authentic_qualification",
    "host_compatible",
    "production_initialization",
    "approval_required",
    "blockers",
    "host_architecture",
    "host_os"
  ]
}
